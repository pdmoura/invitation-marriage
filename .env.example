# Copy to .env and fill in. Never commit the real .env.

PORT=3000
# Public URL of the deployed site (used for Stripe redirect URLs). Optional locally.
PUBLIC_URL=https://seu-casamento.onrender.com

# --- Pix (direct transfer, no fees) ---
# Your Pix key: e-mail, CPF/CNPJ (digits only), phone as +5511999999999, or random (EVP) key.
PIX_KEY=
# Receiver name and city as registered at the bank (accents are stripped automatically).
PIX_RECEIVER_NAME=
PIX_CITY=

# --- Stripe (credit card) ---
# Use sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=
# "true" to also offer Pix inside Stripe Checkout (requires a Brazilian Stripe account with Pix enabled).
STRIPE_ENABLE_PIX=false
# "true" to let guests pay in installments (parcelado) — Brazilian Stripe accounts only.
STRIPE_CARD_INSTALLMENTS=false
