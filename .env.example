# Copy to .env and fill in. Never commit the real .env.

PORT=3000
NODE_ENV=development
# Public URL of the deployed site (used in personalized invite links and Stripe redirects).
PUBLIC_URL=https://pedroesara.onrender.com

# --- Admin panel (/admin) ---
# Password the couple uses to log in. Pick something long.
ADMIN_PASSWORD=
# Any long random string; changing it logs everyone out.
SESSION_SECRET=

# --- Database ---
# Production: a Postgres URL (e.g. free Supabase project → Project Settings → Database → Connection string, "Session pooler").
DATABASE_URL=
# Local development without DATABASE_URL uses a SQLite file (default: data/wedding.db).
# SQLITE_FILE=./data/wedding.db

# --- Photos ---
# Free key from https://unsplash.com/oauth/applications — used by `npm run photos` (also on deploy)
# to resolve the gift/site photos through the official API. Not needed once data/photo-urls.json is committed.
UNSPLASH_ACCESS_KEY=

# --- Pix (direct transfer, no fees) ---
# Your Pix key: e-mail, CPF/CNPJ (digits only), phone as +5561999999999, or random (EVP) key.
PIX_KEY=
# Receiver name and city as registered at the bank (accents are stripped automatically).
PIX_RECEIVER_NAME=Pedro e Sara
PIX_CITY=Formosa

# --- Stripe (credit card) ---
# Use sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=
# Optional but recommended: Stripe Dashboard → Developers → Webhooks → endpoint <PUBLIC_URL>/api/stripe/webhook
# with events checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=
# "true" to also offer Pix inside Stripe Checkout (requires a Brazilian Stripe account with Pix enabled).
STRIPE_ENABLE_PIX=false
# "true" to let guests pay in installments (parcelado) — Brazilian Stripe accounts only.
STRIPE_CARD_INSTALLMENTS=false
